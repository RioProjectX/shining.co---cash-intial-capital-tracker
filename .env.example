# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host application URL
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Vite Client-Side)
# Salin nilai ini dari Firebase Console > Project Settings > General > Your apps (Web)
# atau gunakan konfigurasi yang sudah di-generate di firebase-applet-config.json
VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
