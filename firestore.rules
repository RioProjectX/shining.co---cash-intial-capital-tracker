rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation functions
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'businessId']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 128 &&
        data.role in ['owner', 'admin'] &&
        data.businessId is string && data.businessId.size() <= 128;
    }

    function isValidBusiness(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'currency']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.currency is string && data.currency.size() <= 10;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'businessId', 'name', 'sku', 'costPrice', 'sellingPrice', 'currentStock']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerUid is string &&
        data.businessId is string && data.businessId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.sku is string && data.sku.size() <= 50 &&
        data.costPrice is number && data.costPrice >= 0 &&
        data.sellingPrice is number && data.sellingPrice >= 0 &&
        data.currentStock is number;
    }

    function isValidCapital(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'businessId', 'type', 'amount', 'date']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerUid is string &&
        data.businessId is string && data.businessId.size() <= 128 &&
        data.type in ['initial', 'additional'] &&
        data.amount is number && data.amount > 0 &&
        data.date is string && data.date.size() <= 30;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'businessId', 'invoiceNumber', 'date', 'productId', 'quantity', 'unitPrice', 'totalAmount', 'paymentStatus']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerUid is string &&
        data.businessId is string && data.businessId.size() <= 128 &&
        data.invoiceNumber is string && data.invoiceNumber.size() <= 50 &&
        data.date is string && data.date.size() <= 30 &&
        data.productId is string && data.productId.size() <= 128 &&
        data.quantity is number && data.quantity > 0 &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paymentStatus in ['lunas', 'belum_lunas', 'sebagian'];
    }

    function isValidSalePayment(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'businessId', 'saleId', 'amount', 'date', 'paymentMethod']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerUid is string &&
        data.businessId is string && data.businessId.size() <= 128 &&
        data.saleId is string && data.saleId.size() <= 128 &&
        data.amount is number && data.amount > 0 &&
        data.date is string && data.date.size() <= 30 &&
        data.paymentMethod in ['tunai', 'transfer', 'qris', 'ewallet', 'lainnya'];
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'businessId', 'category', 'amount', 'date', 'description']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerUid is string &&
        data.businessId is string && data.businessId.size() <= 128 &&
        data.category is string && data.category.size() <= 80 &&
        data.amount is number && data.amount > 0 &&
        data.date is string && data.date.size() <= 30 &&
        data.description is string && data.description.size() <= 250;
    }

    function isValidOtherIncome(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'businessId', 'category', 'amount', 'date', 'source']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerUid is string &&
        data.businessId is string && data.businessId.size() <= 128 &&
        data.category is string && data.category.size() <= 80 &&
        data.amount is number && data.amount > 0 &&
        data.date is string && data.date.size() <= 30 &&
        data.source is string && data.source.size() <= 120;
    }

    function isValidInventoryMovement(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'businessId', 'productId', 'type', 'quantityDelta', 'previousStock', 'newStock', 'reason', 'date']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerUid is string &&
        data.businessId is string && data.businessId.size() <= 128 &&
        data.productId is string && data.productId.size() <= 128 &&
        data.type in ['in', 'out', 'adjustment', 'return'] &&
        data.quantityDelta is number &&
        data.previousStock is number &&
        data.newStock is number &&
        data.reason is string && data.reason.size() <= 200 &&
        data.date is string && data.date.size() <= 30;
    }

    // Ping / connection test
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(incoming());
      allow delete: if false;
    }

    // Businesses Collection
    match /businesses/{businessId} {
      allow read: if true;
      allow create, update: if isValidBusiness(incoming());
      allow delete: if false;
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidProduct(incoming());
      allow update: if isValidProduct(incoming());
      allow delete: if true;
    }

    // Capital Transactions Collection
    match /capitalTransactions/{transactionId} {
      allow read: if true;
      allow create: if isValidCapital(incoming());
      allow update: if isValidCapital(incoming());
      allow delete: if true;
    }

    // Sales Collection
    match /sales/{saleId} {
      allow read: if true;
      allow create: if isValidSale(incoming());
      allow update: if isValidSale(incoming());
      allow delete: if true;
    }

    // Sale Payments Collection
    match /salePayments/{paymentId} {
      allow read: if true;
      allow create: if isValidSalePayment(incoming());
      allow update: if false;
      allow delete: if true;
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read: if true;
      allow create: if isValidExpense(incoming());
      allow update: if isValidExpense(incoming());
      allow delete: if true;
    }

    // Other Income Collection
    match /otherIncome/{incomeId} {
      allow read: if true;
      allow create: if isValidOtherIncome(incoming());
      allow update: if isValidOtherIncome(incoming());
      allow delete: if true;
    }

    // Inventory Movements (Immutable Audit Trail)
    match /inventoryMovements/{movementId} {
      allow read: if true;
      allow create: if isValidInventoryMovement(incoming());
      allow update: if false;
      allow delete: if false;
    }
  }
}
